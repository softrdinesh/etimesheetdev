<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Application layer: DTOs, entities, abstractions, validators and business logic.
    It deliberately has NO reference to Infrastructure and NO reference to
    Entity Framework Core, so the compiler enforces the rule that services can
    never touch ApplicationDbContext.
  -->

  <ItemGroup>
    <ProjectReference Include="..\ETimeSheet.Shared\ETimeSheet.Shared.csproj" />
  </ItemGroup>

  <!--
    For IFormFile only: ClientSaveRequest.ClientLogo is bound from a multipart
    form. The shared framework also exposes HttpContext, which this layer must
    still never use - CurrentUserService is the only reader of the request
    (CLAUDE.md §10).
  -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.9.2" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.9.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="6.0.4" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="6.0.1" />
  </ItemGroup>

</Project>
