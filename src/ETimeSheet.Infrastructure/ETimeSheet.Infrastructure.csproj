<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Infrastructure layer: EF Core, repositories and technical service
    implementations for the abstractions declared in the Application layer.
    The framework reference gives access to IHttpContextAccessor without
    pulling in the legacy Microsoft.AspNetCore.Http.Abstractions package.
  -->

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ETimeSheet.Shared\ETimeSheet.Shared.csproj" />
    <ProjectReference Include="..\ETimeSheet.Application\ETimeSheet.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="6.0.36" />
    <!--
      Pinned deliberately. Left alone, EF Core 6 resolves Microsoft.Data.SqlClient
      2.1.x - a 2020-era driver with a different Encrypt default, an older TLS
      stack and weaker Apple Silicon support. 5.1.5 is what EF Core 7 resolved
      before this downgrade, so pinning it keeps the move to .NET 6 a framework
      change only, and leaves the database connection behaving exactly as before.
    -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.1.5" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="6.0.3" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="6.0.1" />
    <!--
      Pinned to 3.x deliberately. Quartz 4 targets net10.0 only, and on net6.0
      its packages restore EMPTY - no assemblies, no error. 3.22.4 resolves
      through netstandard2.0 with low dependency floors, so it moves no
      Microsoft.Extensions.* package off 6.0.
    -->
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.22.4" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="6.36.0" />
  </ItemGroup>

  <!--
    Email templates are read from disk at run time, so they are copied next to
    the binaries - and, through the project reference, into the API's output.
  -->
  <ItemGroup>
    <None Update="Assets\EmailTemplates\**\*.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
